# OAuth Client Credentials (required)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Server configuration (optional)
PORT=24024

# OAuth state is stored here by default and survives restarts (optional)
# OAUTH_STATE_PATH=/absolute/path/to/oauth-state.json

# Set this when the server is behind a trusted reverse proxy (optional)
# PUBLIC_URL=https://mcp.example.com
# TRUST_PROXY=true
