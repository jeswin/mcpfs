# Owner-only secret shown only to the person approving OAuth access.
MCP_AUTH_SECRET=replace-with-a-long-random-secret

# Server configuration (optional)
PORT=24024
MCP_PUBLIC_URL=https://mcp.example.com
OAUTH_STATE_PATH=/var/lib/mcpfs/oauth-state.json

# The synchronized directory is passed as the command-line argument.
# In Docker this defaults to /srv/obsidian/vault.
